# Editor and OS noise.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Secrets. An adapter spec names an environment variable rather than holding a key, so a
# real key only ever arrives through the environment or a local .env. Never commit one.
.env
.env.*
!.env.example
