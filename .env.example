# Copy this file to .env and fill in your own values.
#
# .env is gitignored. Never commit a real key, and never paste one into an issue.
#
# The variable named here is the third field of an adapter spec, for example:
#   npm run auto
#   npm run esac -- run \
#     --model "https://openrouter.ai/api/v1|deepseek/deepseek-chat|OPENROUTER_API_KEY" \
#     --judge "https://openrouter.ai/api/v1|xiaomi/mimo-v2.6-pro|OPENROUTER_API_KEY"
#
# A variable already exported in your shell wins over this file, so CI secrets are never
# shadowed by a stale .env.

OPENROUTER_API_KEY=
